{
  "name": "automation-monorepo-pro",
  "private": true,
  "version": "1.1.0",
  "packageManager": "npm@10.9.0",
  "type": "module",
  "scripts": {
    "bootstrap": "npm run install:all",
    "install:all": "npm -ws install",
    "lint": "eslint . --ext .ts,.tsx,.js,.cjs,.mjs",
    "format": "prettier . --write",
    "test": "npm -ws run test",
    "test:ci": "npm -ws run test:ci",
    "report:serve": "npx http-server ./_reports -p 8080 -o"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "^20.11.30",
    "typescript": "^5.6.3",
    "eslint": "^9.12.0",
    "@eslint/js": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3"
  }
}