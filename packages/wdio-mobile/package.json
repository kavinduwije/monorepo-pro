{
  "name": "wdio-mobile",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "wdio run wdio.conf.ts",
    "test:ci": "wdio run wdio.conf.ts",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "lint": "eslint . --ext .ts",
    "format": "prettier . --write",
    "appium": "appium --base-path /wd/hub"
  },
  "devDependencies": {
    "@wdio/cli": "^9.0.10",
    "@wdio/local-runner": "^9.0.10",
    "@wdio/mocha-framework": "^9.0.10",
    "@wdio/spec-reporter": "^9.0.10",
    "@wdio/allure-reporter": "^9.0.10",
    "@wdio/appium-service": "^9.0.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "webdriverio": "^9.0.10",
    "allure-commandline": "^2.29.0",
    "appium": "^2.13.1",
    "@appium/driver-uiautomator2": "^3.7.1"
  }
}